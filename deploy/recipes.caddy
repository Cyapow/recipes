# Recipes site block for the shared fronting Caddy (imports /etc/caddy/sites/*.caddy).
# The fronting Caddy must be attached to the external `studioos-lan-edge` network
# and provide CF_API_TOKEN.

recipes.matchapman.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	# LAN-only guard.
	@external not remote_ip 10.0.0.0/24 127.0.0.0/8 172.16.0.0/12
	respond @external "Forbidden — LAN access only" 403

	reverse_proxy recipes-app:3000
}
