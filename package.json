{
  "name": "recipes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc && npm run postbuild && tsc -p web && vite build",
    "postbuild": "rm -rf dist/server/migrations && cp -R server/src/migrations dist/server/migrations",
    "test": "vitest run",
    "start": "node dist/server/index.js",
    "dev:web": "vite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
