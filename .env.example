# See docs/setup-google.md for how to get the Google values and set up Drive backups.
PORT=3000
DATA_DIR=/data
# AI (Describe a recipe, and importing pages with no recipe data). Set any one or more of the three keys.
# The first provider with a key is used in the order Claude, ChatGPT, Gemini; set AI_PROVIDER to
# anthropic, openai or gemini to try that one first. If the chosen one fails (bad key, no credit,
# busy, down) the next provider with a key is tried. The models below are the defaults; change them freely.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Reasoning effort sent to OpenAI: none, minimal, low, medium, high, xhigh or max. Values are model-specific and an
# unsupported one is a 400 error. If you set OPENAI_MODEL to a model without reasoning, set this to default (or leave
# it empty) so the field is not sent.
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini thinking level: minimal, low, medium or high (Gemini 3 and later). For an older model set default (or leave
# it empty) so the field is not sent.
GEMINI_THINKING_LEVEL=low
# Overall time limit for one AI request across all providers and retries (milliseconds, minimum 10000).
AI_TOTAL_TIMEOUT_MS=100000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://recipes.matchapman.dev
BACKUP_HOUR=3
# Timezone used for BACKUP_HOUR (read by docker-compose.yml)
TZ=Europe/London
