# See docs/setup-google.md for how to get the Google values and set up Drive backups.
PORT=3000
DATA_DIR=/data
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://recipes.matchapman.dev
BACKUP_HOUR=3
# Timezone used for BACKUP_HOUR (read by docker-compose.yml)
TZ=Europe/London
